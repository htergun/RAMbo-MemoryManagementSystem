<Window x:Class="RAMbo.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RAMbo.App.Views"
        mc:Ignorable="d"
        Title="RAMbo - Memory Management Simulator" 
        Height="820" Width="1100"
        MinHeight="700" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F1F5F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation / Header -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RAMbo" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" - Memory Management System" FontSize="13" Foreground="#94A3B8" 
                               VerticalAlignment="Center" Margin="6,2,0,0"/>
                </StackPanel>

                <!-- Database Status Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="DotDbStatus" Width="9" Height="9" Fill="#10B981" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtDbStatus" Text="Database: Connected" FontSize="12" FontWeight="SemiBold" 
                               Foreground="#CBD5E1" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,8,0,0"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Page Replacement">
                <views:PageReplacementView x:Name="ViewPageReplacement"/>
            </TabItem>

            <TabItem Header="Memory Partitioning">
                <views:PartitioningView x:Name="ViewPartitioning"/>
            </TabItem>

            <TabItem Header="Simulation History">
                <views:HistoryView x:Name="ViewHistory"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
